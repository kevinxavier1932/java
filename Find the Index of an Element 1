import java.util.*;
import java.io.*;
public class Main{
       public static void main(String[] args){
  Scanner s=new Scanner(System.in);
           int N=s.nextInt();
           int[] a=new int[N];
           for(int i=0;i<N;i++){
               a[i]=s.nextInt();
           }
        int x=s.nextInt();
           int index= -1;
           for(int i=0;i<N;i++){
               if(a[i]==x){
                   index=i;
               }
           }System.out.println(index);
       }
}
