import java.util.*;
import java.io.*;
public class Main{
       public static void main(String[] args){
  Scanner s=new Scanner(System.in);
           int N=s.nextInt();
           int sum=0;
       for(int i=0;i<N;i++){
           int num=s.nextInt();
           if(num%2==0){
               sum+=num;
               
           }
       }
       System.out.println(sum);
}   
       
       }
