import java.io.*;
import java.util.*;
public class Solution {
    static void isprime(int n){
        if(n<1){
            System.out.println("NOt Prime");
            return;
        }
        for(int i=2;i<n;i++){
            if(n%i==0){
                System.out.println("Not Prime");
                return;
            }
        }
        System.out.println("Prime");
    }
    public static void main(String[] args) {
        Scanner s=new Scanner(System.in);
        int n=s.nextInt();
        isprime(n);
        }
    }
