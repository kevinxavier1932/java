import java.io.*;
import java.util.*;
public class Solution {
  public static int largest(int a,int b,int c){
        int max = a;
        if(b>max){
            max=b;}
        if(c>max){
            max=c;
       } return max;

        }
    public static void main(String[] args) {
    Scanner s=new Scanner(System.in);
        int a=s.nextInt();
        int b=s.nextInt();
        int c=s.nextInt();
        int result=largest(a,b,c);
        System.out.println(result);
    
    }
}
